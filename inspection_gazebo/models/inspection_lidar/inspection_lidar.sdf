<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="inspection_lidar">
    <link name="link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <inertial>
        <mass>0.25</mass>
        <inertia>
          <ixx>2.2e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.2e-5</iyy>
          <iyz>0</iyz>
          <izz>2.2e-5</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.060</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="scan_ring">
        <pose>0 0 0.034 0 0 0</pose>
        <geometry><cylinder><radius>0.052</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.03 0.16 0.20 1</ambient><diffuse>0.03 0.16 0.20 1</diffuse><specular>0.5 0.65 0.7 1</specular></material>
      </visual>
      <sensor name="mid360" type="ray">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2617993878</min_angle>
              <max_angle>0.2617993878</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>70.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <!-- This plugin is provided by ros-humble-gazebo-plugins.  The
             PointCloud2 topic is shaped like a MID-360 data stream; it is
             still synthetic Gazebo data, not a hardware driver. -->
        <plugin name="mid360_ros" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/inspection/mid360</namespace>
            <remapping>~/out:=points</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>inspection_mid360_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
